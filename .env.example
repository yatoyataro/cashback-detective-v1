# Cashback Detective Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (Required)
# ============================================
# Neon PostgreSQL - Use POOLED connection string for application runtime
# Get from Neon Console: Connection Details → Pooled connection (toggle ON)
# Format: postgresql://user:pass@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require

# For migrations only - use DIRECT connection (no -pooler in hostname)
# DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# Local development alternative (if using local PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashback_detective

# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# LOGGING
# ============================================
# debug, info, warn, error
LOG_LEVEL=info

# ============================================
# AUTHENTICATION
# ============================================
# IMPORTANT: Change this in production! Generate with: openssl rand -base64 32
# MUST be 32+ chars in production
JWT_SECRET=dev-secret-change-in-production

# CSRF protection (auto-generated if not set)
# CSRF_SECRET=optional-custom-secret

# ============================================
# RATE LIMITING (Optional tuning)
# ============================================
# General API: requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth endpoints: stricter limits
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Strict endpoints (investigate, transactions)
STRICT_RATE_LIMIT_WINDOW_MS=60000
STRICT_RATE_LIMIT_MAX=10

# ============================================
# AI FEATURES (Optional)
# ============================================
# Ollama model for general questions (requires local Ollama installation)
OLLAMA_MODEL=qwen3:4b

# Enable AI-powered general questions (requires Ollama running)
# Set to "true" to enable, "false" to use predefined responses only
ENABLE_AI_GENERAL_QUESTIONS=false

# ============================================
# FRONTEND (Vite)
# ============================================
# API base URL for frontend (set in frontend/.env if different)
# VITE_API_BASE=http://localhost:3000